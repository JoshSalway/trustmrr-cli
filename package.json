{
  "name": "trustmrr-cli-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first CLI + MCP server for querying TrustMRR verified-revenue data via your Claude subscription",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter trustmrr-cli dev",
    "cli": "pnpm --filter trustmrr-cli start",
    "mcp": "pnpm --filter trustmrr-mcp start",
    "probe": "pnpm --filter trustmrr-mcp probe",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@biomejs/biome"]
  }
}
