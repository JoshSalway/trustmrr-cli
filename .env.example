# TrustMRR API key — get one at https://trustmrr.com (Settings → API keys).
# Keys start with "tmrr_". One active key per account. Never commit a real key.
TRUSTMRR_API_KEY=tmrr_xxx

# Optional: override the API base URL (defaults to https://trustmrr.com/api/v1)
# TRUSTMRR_BASE_URL=https://trustmrr.com/api/v1
