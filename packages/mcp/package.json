{
  "name": "@joshsalway/trustmrr-mcp",
  "version": "0.1.0",
  "description": "Unofficial standalone stdio MCP server wrapping the TrustMRR verified-revenue REST API",
  "type": "module",
  "license": "MIT",
  "author": "Josh Salway",
  "homepage": "https://github.com/JoshSalway/trustmrr-cli/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoshSalway/trustmrr-cli.git",
    "directory": "packages/mcp"
  },
  "bugs": { "url": "https://github.com/JoshSalway/trustmrr-cli/issues" },
  "publishConfig": { "access": "public" },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "trustmrr",
    "startups",
    "revenue",
    "mrr",
    "saas",
    "claude",
    "cursor"
  ],
  "engines": { "node": ">=20" },
  "bin": {
    "trustmrr-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "src", "test", "README.md", "tsconfig.json", "tsup.config.ts"],
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "pnpm build && tsx --test test/*.test.ts",
    "probe": "tsx src/scripts/probe.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "tsup",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
